{
  "entities": {
    "HospitalConfig": {
      "title": "HospitalConfig",
      "description": "Global hospital profile, description, and administrator access control settings.",
      "type": "object",
      "properties": {
        "hospitalName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 120,
          "description": "Official hospital name displayed across the portal."
        },
        "tagline": {
          "type": "string",
          "minLength": 2,
          "maxLength": 200,
          "description": "Short hospital subtitle or clinical mission tagline."
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "maxLength": 1500,
          "description": "Detailed hospital profile description and patient guidance."
        },
        "address": {
          "type": "string",
          "minLength": 4,
          "maxLength": 250,
          "description": "Hospital street address and campus wing."
        },
        "phone": {
          "type": "string",
          "minLength": 5,
          "maxLength": 40,
          "description": "Hospital reception and emergency helpline number."
        },
        "opdHours": {
          "type": "string",
          "minLength": 3,
          "maxLength": 100,
          "description": "Outpatient consultation operating hours."
        },
        "portalOpen": {
          "type": "boolean",
          "description": "Master switch controlled by admin to enable or pause online token bookings."
        },
        "allowNewRegistrations": {
          "type": "boolean",
          "description": "Master switch controlled by admin to allow or pause new patient account onboarding."
        },
        "maintenanceMessage": {
          "type": "string",
          "minLength": 0,
          "maxLength": 500,
          "description": "Notice displayed to patients when OPD token intake is paused."
        },
        "acceptedPaymentMethods": {
          "type": "array",
          "description": "Enabled consultation payment channels."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Server timestamp of last configuration update."
        },
        "updatedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$",
          "description": "UID of the administrator who last updated settings."
        }
      },
      "required": [
        "hospitalName",
        "tagline",
        "description",
        "address",
        "phone",
        "opdHours",
        "portalOpen",
        "allowNewRegistrations",
        "maintenanceMessage",
        "acceptedPaymentMethods",
        "updatedAt",
        "updatedBy"
      ]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Patient or administrator profile with personal description and access status.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 0,
          "maxLength": 150
        },
        "profileDescription": {
          "type": "string",
          "minLength": 0,
          "maxLength": 800,
          "description": "Patient personal profile description, medical preferences, and visit notes."
        },
        "phone": {
          "type": "string",
          "minLength": 0,
          "maxLength": 30
        },
        "bloodGroup": {
          "type": "string",
          "minLength": 0,
          "maxLength": 10
        },
        "permanentAddress": {
          "type": "string",
          "minLength": 0,
          "maxLength": 300,
          "description": "Patient permanent residential address."
        },
        "emergencyContact": {
          "type": "string",
          "minLength": 0,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["patient", "admin"]
        },
        "accessStatus": {
          "type": "string",
          "enum": ["active", "suspended"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "displayName",
        "email",
        "profileDescription",
        "phone",
        "bloodGroup",
        "permanentAddress",
        "emergencyContact",
        "role",
        "accessStatus",
        "createdAt",
        "updatedAt"
      ]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Trusted allowlist record for delegated hospital administrators.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "minLength": 3,
          "maxLength": 150
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "grantedBy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "grantedBy", "createdAt"]
    },
    "Doctor": {
      "title": "Doctor",
      "description": "Doctor directory profile with per-doctor live token queue counters and consultation fee.",
      "type": "object",
      "properties": {
        "doctorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "credentials": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "specialty": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "consultationFee": {
          "type": "number"
        },
        "tokenPrefix": {
          "type": "string",
          "minLength": 2,
          "maxLength": 8,
          "pattern": "^[A-Z0-9]+$"
        },
        "currentServingNumber": {
          "type": "integer"
        },
        "lastIssuedNumber": {
          "type": "integer"
        },
        "totalTokens": {
          "type": "integer",
          "description": "Maximum number of selectable 10-minute tokens per session (default 10)."
        },
        "opdDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
          "description": "Scheduled OPD consultation date for the doctor (YYYY-MM-DD)."
        },
        "isAvailable": {
          "type": "boolean"
        },
        "shiftHours": {
          "type": "string",
          "minLength": 2,
          "maxLength": 80
        },
        "experienceYears": {
          "type": "integer"
        },
        "bio": {
          "type": "string",
          "minLength": 10,
          "maxLength": 600
        },
        "avatarUrl": {
          "type": "string",
          "minLength": 0,
          "maxLength": 200000
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "doctorId",
        "name",
        "credentials",
        "specialty",
        "department",
        "room",
        "consultationFee",
        "tokenPrefix",
        "currentServingNumber",
        "lastIssuedNumber",
        "isAvailable",
        "shiftHours",
        "experienceYears",
        "bio",
        "avatarUrl",
        "updatedAt"
      ]
    },
    "TokenBooking": {
      "title": "TokenBooking",
      "description": "Patient OPD queue token issued for a specific doctor along with payment status.",
      "type": "object",
      "properties": {
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "department": {
          "type": "string",
          "minLength": 2,
          "maxLength": 60
        },
        "room": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "tokenNumber": {
          "type": "integer"
        },
        "tokenCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "patientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "visitReason": {
          "type": "string",
          "minLength": 2,
          "maxLength": 400
        },
        "feeAmount": {
          "type": "number"
        },
        "paymentStatus": {
          "type": "string",
          "enum": ["paid", "pending", "refunded"]
        },
        "paymentMethod": {
          "type": "string",
          "enum": ["Card", "UPI", "Insurance", "Hospital Desk"]
        },
        "paymentRef": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "queueStatus": {
          "type": "string",
          "enum": ["waiting", "serving", "completed", "cancelled"]
        },
        "bookingDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "slotTime": {
          "type": "string",
          "minLength": 0,
          "maxLength": 40,
          "description": "10-minute consultation slot window for this token."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "tokenId",
        "doctorId",
        "doctorName",
        "department",
        "room",
        "tokenNumber",
        "tokenCode",
        "patientUid",
        "patientName",
        "visitReason",
        "feeAmount",
        "paymentStatus",
        "paymentMethod",
        "paymentRef",
        "queueStatus",
        "bookingDate",
        "createdAt",
        "updatedAt"
      ]
    },
    "PaymentRecord": {
      "title": "PaymentRecord",
      "description": "Consultation payment ledger record tied to a doctor token booking.",
      "type": "object",
      "properties": {
        "paymentId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "tokenCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "doctorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 100
        },
        "patientUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "patientName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "amount": {
          "type": "number"
        },
        "method": {
          "type": "string",
          "enum": ["Card", "UPI", "Insurance", "Hospital Desk"]
        },
        "status": {
          "type": "string",
          "enum": ["paid", "pending", "refunded"]
        },
        "referenceCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 64
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "paymentId",
        "tokenId",
        "tokenCode",
        "doctorId",
        "doctorName",
        "patientUid",
        "patientName",
        "amount",
        "method",
        "status",
        "referenceCode",
        "createdAt"
      ]
    },
    "DoctorSlot": {
      "title": "DoctorSlot",
      "description": "Exclusive lock record preventing duplicate selection of a doctor token number on a given date.",
      "type": "object",
      "properties": {
        "slotId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "doctorId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "bookingDate": {
          "type": "string",
          "minLength": 10,
          "maxLength": 10,
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "tokenNumber": {
          "type": "integer"
        },
        "tokenCode": {
          "type": "string",
          "minLength": 2,
          "maxLength": 20
        },
        "slotTime": {
          "type": "string",
          "minLength": 3,
          "maxLength": 40
        },
        "tokenId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "slotId",
        "doctorId",
        "bookingDate",
        "tokenNumber",
        "tokenCode",
        "slotTime",
        "tokenId",
        "createdAt"
      ]
    }
  },
  "firestore": {
    "/hospitalConfig/{configId}": {
      "schema": { "$ref": "#/entities/HospitalConfig" },
      "description": "Hospital profile, name, description, and global portal access settings (document id: settings)."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Patient and staff user profiles with PII isolation and admin-controlled accessStatus."
    },
    "/admins/{adminUid}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Admin role allowlist managed by existing administrators."
    },
    "/doctors/{doctorId}": {
      "schema": { "$ref": "#/entities/Doctor" },
      "description": "Available doctors, consultation fees, and per-doctor live token queue counters."
    },
    "/tokens/{tokenId}": {
      "schema": { "$ref": "#/entities/TokenBooking" },
      "description": "Booked OPD queue tokens per doctor and patient."
    },
    "/payments/{paymentId}": {
      "schema": { "$ref": "#/entities/PaymentRecord" },
      "description": "Payment receipts and transaction records linked to token bookings."
    },
    "/doctorSlots/{slotId}": {
      "schema": { "$ref": "#/entities/DoctorSlot" },
      "description": "Exclusive per-doctor per-date token slot locks with no PII."
    }
  }
}
